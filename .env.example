# =============================================================================
# DZ COLLECTION — variáveis de ambiente
# =============================================================================
# APENAS NOMES E EXEMPLOS. Nenhum valor real neste arquivo, nunca.
# Valores reais vivem em apps/site/.env.local (ignorado pelo git) e nas
# Environment Variables da Vercel.
#
# É uma aplicação só: a loja em / e o painel em /admin.
# =============================================================================

# --- Públicas (vão para o browser; podem aparecer no bundle) ------------------

# URL pública do site. Usada no link enviado por WhatsApp, canonical, sitemap,
# Open Graph e na validação de origem das mutations do painel.
# NUNCA localhost em produção.
NEXT_PUBLIC_SITE_URL=https://dz-collection.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Publishable key (sb_publishable_...). É pública por natureza: todo acesso
# continua limitado por grants + RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# --- SERVER-ONLY — jamais com prefixo NEXT_PUBLIC_, jamais no git -------------

# Secret key (sb_secret_...). Privilégio máximo: ignora RLS.
#
# Usada em UM único lugar: o controle de tentativas de login
# (src/lib/admin/rate-limit.ts). A tabela auth_rate_limits não tem grant para
# ninguém, de propósito — se o navegador pudesse chamar consume_rate_limit(),
# qualquer pessoa trancaria a conta da proprietária só repetindo a chamada.
#
# O acesso a ela é barrado em três camadas: requireServerEnv() recusa qualquer
# nome NEXT_PUBLIC_ e lança se chamada no navegador; o módulo do cliente admin
# tem `import 'server-only'`, que quebra o build se algum componente de cliente
# tentar importá-lo; e rate-limit.ts também é server-only.
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX
