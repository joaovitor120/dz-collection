# =============================================================================
# DZ COLLECTION — variáveis de ambiente
# =============================================================================
# APENAS NOMES E EXEMPLOS. Nenhum valor real neste arquivo, nunca.
# Valores reais vivem em .env.local (ignorado pelo git) e nas Environment
# Variables da Vercel.
# =============================================================================

# --- Públicas (vão para o browser; podem aparecer no bundle) ------------------

# URL pública do catálogo. Usada no link enviado por WhatsApp, canonical,
# sitemap e Open Graph. NUNCA localhost em produção.
NEXT_PUBLIC_SITE_URL=https://dz-collection.vercel.app

# URL do painel administrativo. Usada na validação de Origin das mutations.
NEXT_PUBLIC_ADMIN_URL=https://dz-collection-adm.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Publishable key (sb_publishable_...). É pública por natureza: todo acesso
# continua limitado por grants + RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# --- SERVER-ONLY — jamais com prefixo NEXT_PUBLIC_, jamais no git -------------

# Secret key (sb_secret_...). Privilégio máximo: ignora RLS.
# Só no projeto admin da Vercel e no .env.local da sua máquina.
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# Segredo compartilhado entre admin e site público para revalidação de cache.
# Gere com: openssl rand -base64 32
REVALIDATE_SECRET=troque-por-um-valor-aleatorio-longo
