{
  "name": "dz-collection",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dz/site",
    "build": "npm run build -w @dz/site",
    "start": "npm run start -w @dz/site",
    "typecheck": "tsc -b apps/site packages/shared",
    "lint": "npm run lint -w @dz/site",
    "test:db": "./supabase/tests/run-local.sh",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.mts",
    "verify:migration": "node --experimental-strip-types --no-warnings scripts/verify-migration.mts",
    "imagens:subir": "node scripts/subir-imagens.mjs"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "playwright": "^1.47.2",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
