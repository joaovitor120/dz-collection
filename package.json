{
  "name": "dz-collection",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:site": "npm run dev -w @dz/site",
    "dev:admin": "npm run dev -w @dz/admin",
    "build": "npm run build -w @dz/site && npm run build -w @dz/admin",
    "build:site": "npm run build -w @dz/site",
    "build:admin": "npm run build -w @dz/admin",
    "typecheck": "tsc -b apps/site apps/admin packages/shared",
    "lint": "npm run lint -w @dz/site && npm run lint -w @dz/admin",
    "test:db": "./supabase/tests/run-local.sh",
    "test:security": "node --experimental-strip-types --no-warnings scripts/security-suite.mts",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.mts",
    "verify:migration": "node --experimental-strip-types --no-warnings scripts/verify-migration.mts"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.3"
  },
  "engines": { "node": ">=20.11" }
}
